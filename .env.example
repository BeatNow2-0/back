ENVIRONMENT=production
DEBUG=false
APP_NAME=BeatNow API
SECRET_KEY=change_me_with_a_very_long_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080
PASSWORD_RESET_EXPIRE_MINUTES=30
CONFIRMATION_CODE_EXPIRE_MINUTES=10

MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/BeatNow?retryWrites=true&w=majority
MONGO_DB=BeatNow

CORS_ORIGINS=https://app.beatnow.app
PUBLIC_BASE_URL=https://api.beatnow.app
MEDIA_ROOT=/var/lib/beatnow/media
DEFAULT_PROFILE_IMAGE=/opt/beatnow-back/static/photo-profile.jpg

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=mailer@example.com
SMTP_PASSWORD=change_me
EMAIL_SENDER=no-reply@beatnow.app

RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT=5
RESET_RATE_LIMIT=3
CONFIRMATION_RATE_LIMIT=5

PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9000
